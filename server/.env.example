# Spray naira backend. PLACEHOLDERS ONLY: never commit the real file (server/.env is gitignored).

PORT=4100
# Local: a Postgres database you created for Spray. VPS: same idea, separate from ShopSwift's database.
DATABASE_URL=postgres://spray:CHANGE_ME@localhost:5432/spray
# The web app's address(es), comma separated, e.g. http://localhost:5173,https://spray.shopswiftpay.com
SPRAY_ALLOWED_ORIGINS=http://localhost:5173
# Never "production" while using VFD sandbox keys (the sandbox safety check refuses to start).
NODE_ENV=development

# --- Demo mode ------------------------------------------------------------
# true = pretend bank, no VFD keys needed (local demos only; refused when NODE_ENV=production)
SPRAY_FAKE_BANK=false

# --- VFD sandbox: copy these values from ShopSwiftApp's artifacts/api-server/.env -----------
VFD_ENV=sandbox
VFD_CONSUMER_KEY=replace-with-sandbox-consumer-key
VFD_CONSUMER_SECRET=replace-with-sandbox-consumer-secret
VFD_WALLET_NAME=replace
VFD_COLLECTION_ACCOUNT_NUMBER=0000000000
VFD_OWN_BANK_CODE=999999
# VFD_BAAS_CLIENT_PORTAL=
VFD_DISPLAY_BANK_NAME=VFD Microfinance Bank

# Webhook is OPTIONAL: Spray confirms bundles by polling VFD's status query.
# To also receive webhooks: set a 24+ character secret and point the VBaaS portal to
#   https://<api host>/api/vfd/webhook/<VFD_WEBHOOK_SECRET>
VFD_WEBHOOK_SECRET=
VFD_WEBHOOK_AUTH_HEADER=x-shopswift-webhook-key
VFD_WEBHOOK_AUTH_VALUE=
VFD_WEBHOOK_AUTH_PREFIX=Bearer
VFD_WEBHOOK_IPS=

# --- Business rules ---------------------------------------------------------
SPRAY_FEE_BPS=400            # Spray's fee: 400 = 4% of everything sprayed
SPRAY_PLANNER_SHARE_BPS=2500 # Planner's share of Spray's fee: 2500 = 25%
SPRAY_DEPOSIT_MINUTES=30     # How long a bundle's transfer account stays open
SPRAY_AMOUNTS_NAIRA=200,500,1000,2000,5000
SPRAY_DEPOSIT_POLL_SECONDS=8
