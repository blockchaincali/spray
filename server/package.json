{
  "name": "spray-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Spray naira backend: bundles paid by VFD bank transfer, live sprays, celebrant payouts",
  "scripts": {
    "start": "node --import tsx src/index.ts",
    "dev": "node --env-file=.env --import tsx --watch src/index.ts",
    "migrate": "node --env-file=.env --import tsx src/migrate.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "pg": "^8.13.1",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.2"
  }
}
